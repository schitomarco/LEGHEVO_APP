{
  "name": "leghevo-mobile",
  "description": "App iOS e Android per il fantasy football LEGHEVO.",
  "private": true,
  "version": "0.62.46",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.23",
    "expo-file-system": "~56.0.9",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.23",
    "expo-sharing": "~56.0.24",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/xcpretty": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npm ping --registry=https://registry.npmjs.org/ && npm cache verify",
    "verify": "npm run typecheck && npx expo export --platform android --platform ios --output-dir dist-verify",
    "install:clean": "npm ci --registry=https://registry.npmjs.org/",
    "release:fingerprint": "node scripts/compute-release-fingerprint.mjs"
  }
}
