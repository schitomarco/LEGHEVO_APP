{
  "name": "leghevo-mobile",
  "description": "App iOS e Android per il fantasy football LEGHEVO.",
  "private": true,
  "version": "0.62.45",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/xcpretty": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npm ping --registry=https://registry.npmjs.org/ && npm cache verify",
    "verify": "npm run typecheck && npx expo export --platform android --platform ios --output-dir dist-verify",
    "install:clean": "npm ci --registry=https://registry.npmjs.org/",
    "release:fingerprint": "node scripts/compute-release-fingerprint.mjs"
  }
}
