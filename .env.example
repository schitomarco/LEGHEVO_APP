# Runtime environment. Use development locally, staging for TestFlight/internal
# Play tests and production only with the dedicated production Supabase project.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Development Test Store only. A test_ key is rejected outside __DEV__.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_replace_me
EXPO_PUBLIC_REVENUECAT_STORE_MODE=test
EXPO_PUBLIC_REVENUECAT_PURCHASES_ENABLED=false

# App Store / Google Play builds. Configure these in the EAS production
# environment, never with private store credentials.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me
